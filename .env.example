# Optional Ghost (also connectable in-app)
# GHOST_API_URL=https://your-site.ghost.io
# GHOST_ADMIN_API_KEY=id:secret

# Optional Telegram (also connectable in-app — SoMePoster-style)
# TELEGRAM_BOT_TOKEN=1234567890:AAH...
# TELEGRAM_CHANNEL_ID=-1001234567890

# Optional Webflow (also connectable in-app — SoMePoster-style)
# WEBFLOW_API_TOKEN=
# WEBFLOW_SITE_ID=
# WEBFLOW_COLLECTION_ID=

# Optional LiveJournal (also connectable in-app — SoMePoster-style)
# LIVEJOURNAL_USERNAME=
# LIVEJOURNAL_PASSWORD=

# Optional Threads (Meta OAuth — SoMePoster-style)
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# THREADS_REDIRECT_URI=https://your-domain/api/threads/callback
# Or paste manually in-app:
# THREADS_ACCESS_TOKEN=
# THREADS_USER_ID=

# Optional OpenAI (also connectable in-app under Integrations → OpenAI)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional Tumblr (also connectable in-app)
# TUMBLR_CLIENT_ID=
# TUMBLR_CLIENT_SECRET=
# TUMBLR_REDIRECT_URI=https://your-domain/api/tumblr/callback
# TUMBLR_ACCESS_TOKEN=
# TUMBLR_BLOG_IDENTIFIER=myblog.tumblr.com

# Optional Mastodon (also connectable in-app)
# MASTODON_INSTANCE=https://mastodon.social
# MASTODON_CLIENT_ID=
# MASTODON_CLIENT_SECRET=
# MASTODON_ACCESS_TOKEN=

# Optional Hashnode (also connectable in-app)
# HASHNODE_ACCESS_TOKEN=
# HASHNODE_PUBLICATION_ID=

# Optional Instantly API v2 (also connectable in-app)
# INSTANTLY_API_KEY=
